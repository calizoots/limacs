;;; pkgs/my-ligatures.el

(use-package ligature
  :ensure t
  :config
  (ligature-set-ligatures
   'prog-mode
   '("--" "---" "==" "===" "!=" "!==" "=!=" "=:=" "=/="
     "<=" ">=" "&&" "&&&" "&=" "++" "+++"
     "***" ";;" "!!" "??" "?:" "?." "?="
     "<:" ":<" ":>" ">:" "<>" "<<<" ">>>"
     "<<" ">>" "||" "-|" "_|_" "|-" "||-"
     "|=" "||=" "##" "###" "####"
     "#{" "#[" "]#" "#(" "#?" "#_" "#_(" "#:"
     "#!" "#=" "^=" "<$>" "<$" "$>" "<+>" "<+>"
     "</>" "</" "/>" "<!--" "-->"
     "->" "->>" "<<-" "<-" "<=<" "=<<"
     "<<=" "<==" "<=>" "<==>" "==>" "=>"
     "=>>" ">=>" ">>=" ">>-" ">-" ">--"
     "-<" "-<<" ">->" "<-<" "<-|"
     "<=|" "|=>" "|->" "<-"
     "<~~" "<~" "<~>" "~~" "~~>" "~>"
     "~-" "-~" "~@" "|>" "<|" "||>" "<||"
     "<|>" ".=" "..<" ".?" "::" ":::"
     ":=" "::=" ":?" ":?>" "//" "///"
     "/*" "*/" "/=" "//=" "/==" "@_" "__"))

  (global-ligature-mode 1))

(provide 'my-ligatures)

;;; my-ligatures.el ends here
