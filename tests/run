#!/usr/bin/env bash
# Run the config's tests in batch Emacs (no windows open).
#   tests/run              every test
#   tests/run git          only tests whose name matches "git"
cd "$(dirname "$0")/.." || exit 1
selector=${1:+"(setq my-test-selector \"$1\")"}
files=()
for f in tests/test-*.el; do files+=(-l "$f"); done
exec emacs -Q --batch \
     --eval "${selector:-nil}" \
     -l tests/helper.el "${files[@]}" \
     --eval '(ert-run-tests-batch-and-exit (if (boundp (quote my-test-selector)) my-test-selector t))'
